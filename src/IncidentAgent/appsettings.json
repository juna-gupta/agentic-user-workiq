{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Microsoft.Identity.Web": "Warning",
      "Microsoft.Teams.Apps.TeamsBotApplication": "Warning"
    }
  },
  "AllowedHosts": "*",

  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "",
    "ClientId": "",
    "ClientCredentials": [
      {
        "SourceType": "ClientSecret",
        "ClientSecret": ""
      }
    ]
  },

  "WorkIq": {
    "Endpoint": "https://workiq.svc.cloud.microsoft/mcp",
    "Scope": "api://workiq.svc.cloud.microsoft/.default"
  },

  "AzureOpenAI": {
    "Provider": "AzureOpenAI",
    "Endpoint": "",
    "Deployment": "",
    "ManagedIdentityClientId": ""
  },

  "Agent": {
    "Name": "Iris",
    "Role": "the helpdesk engineering team's incident agent",
    "DefaultTimeZone": "America/Los_Angeles",
    "GreetWhenAdded": true
  },

  "Watch": {
    "Enabled": true,
    "PollSeconds": 10,
    "WindowMinutes": 10,
    "SettleSeconds": 5,
    "MinConfidence": 0.7,
    "MessagesPerPoll": 10,
    "ReceivesAllMessages": false
  },

  "Runbook": {
    "Path": "/Runbooks/helpdesk-bot-runbook.md",
    "CacheMinutes": 30,
    "MaxCatalog": 40
  },

  "Shiproom": {
    "MeetingKeyword": "shiproom",
    "LookAheadDays": 7,
    "SlideTitle": "Incident updates"
  },

  "Conversation": {
    "GroupChatHours": 24,
    "GroupChatMinimumMessages": 25,
    "MaxMessages": 300
  },

  "WorkQueue": {
    "MaxConcurrency": 8,
    "TimeoutSeconds": 300
  },

  "Features": {
    "Streaming": "Personal",
    "TargetedMessages": false,
    "SensitivityLabel": "",
    "SensitivityLabelDescription": "",
    "DraftCard": true,
    "HtmlWidget": false,
    "WidgetDomain": "",
    "ReactionAck": true
  }
}
